# Variaveis lidas pelo docker-compose.yml.
#
# Nao edite este arquivo: ele e so um exemplo do formato. O .env de verdade e
# criado pelo iniciar-container.ps1 na primeira subida, com valores aleatorios
# gerados nesta maquina, e fica fora do git.

# Senha do root do MySQL do container. O banco nao publica a porta 3306, entao
# ela so vale de dentro da rede do compose.
MYSQL_ROOT_PASSWORD=troque-por-um-valor-aleatorio

# Senha do usuario 'digitado', que e como a aplicacao conecta no banco
# (o perfil prod nao usa root - veja application-prod.yml).
DIGITADO_DB_PASSWORD=troque-por-um-valor-aleatorio

# Chave que assina os tokens de login, em Base64 e com pelo menos 256 bits.
# Sem ela a aplicacao nao sobe. Gerar com: openssl rand -base64 64
JWT_SECRET=troque-por-um-valor-aleatorio
