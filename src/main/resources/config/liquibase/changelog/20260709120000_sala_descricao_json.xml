<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        A coluna descricao deixa de ser longtext e vira JSON, no formato
        {"descricao": "<texto>", "modo": "1v1" | "normal"}.
        Primeiro embrulha o texto existente de cada sala num objeto JSON (o modo vem da
        coluna tipo), depois converte o tipo da coluna — a conversão exige que todas as
        linhas já contenham JSON válido.
    -->
    <changeSet id="20260709120000-1" author="digitado">
        <sql>
            UPDATE sala
            SET descricao = JSON_OBJECT(
                'descricao', descricao,
                'modo', CASE WHEN tipo = 'UM_V_UM' THEN '1v1' ELSE 'normal' END
            )
        </sql>
        <modifyDataType tableName="sala" columnName="descricao" newDataType="json"/>
    </changeSet>
</databaseChangeLog>
