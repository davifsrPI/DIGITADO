<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Torna o sobrenome do Usuario OPCIONAL.
        Antes era NOT NULL, o que obrigava o admin a preencher um sobrenome ao
        validar/ativar a conta de um aluno — o registro público nem coleta esse campo.
    -->
    <changeSet id="20260706150000-1" author="digitado">
        <dropNotNullConstraint tableName="usuario" columnName="sobrenome" columnDataType="varchar(255)"/>
    </changeSet>
</databaseChangeLog>
