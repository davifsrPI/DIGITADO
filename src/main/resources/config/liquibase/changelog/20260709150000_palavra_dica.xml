<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Coluna dica na tabela palavra — texto opcional exibido como pista na Palavra do Dia.
        A coluna foi criada manualmente no banco de desenvolvimento, então a precondição
        MARK_RAN pula o changeset onde ela já existe; bancos novos (testes, produção)
        ganham a coluna normalmente.
    -->
    <changeSet id="20260709150000-1" author="digitado">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="palavra" columnName="dica"/>
            </not>
        </preConditions>
        <addColumn tableName="palavra">
            <column name="dica" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
