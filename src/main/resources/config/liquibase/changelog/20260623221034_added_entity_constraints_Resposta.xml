<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Resposta.
    -->
    <changeSet id="20260623221034-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="atividade_id"
                                 baseTableName="resposta"
                                 constraintName="fk_resposta__atividade_id"
                                 referencedColumnNames="id"
                                 referencedTableName="atividade"
                                 />

        <addForeignKeyConstraint baseColumnNames="aluno_id"
                                 baseTableName="resposta"
                                 constraintName="fk_resposta__aluno_id"
                                 referencedColumnNames="id"
                                 referencedTableName="usuario"
                                 />

        <addForeignKeyConstraint baseColumnNames="palavra_id"
                                 baseTableName="resposta"
                                 constraintName="fk_resposta__palavra_id"
                                 referencedColumnNames="id"
                                 referencedTableName="palavra"
                                 />
    </changeSet>
</databaseChangeLog>
